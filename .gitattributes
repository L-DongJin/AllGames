# Normalize text files across Windows and other development environments.
* text=auto
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf

# Keep Unreal Engine binary assets outside the regular Git object database.
# These rules must come after `* text=auto` so binary assets remain non-text.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
